{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "demo-react",
  "projectType": "application",
  "sourceRoot": "apps/demo-react/src",
  "tags": ["scope:demo"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "inputs": [
        "default",
        "!{projectRoot}/e2e/**/*",
        "!{projectRoot}/playwright.config.ts",
        "^production",
        { "env": "DSF_DEMO_BASE" }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": ["tsc -p tsconfig.app.json --noEmit", "tsc -p tsconfig.node.json --noEmit"],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "eslint ."
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "{workspaceRoot}/README.md", { "env": "DSF_DEMO_BASE" }],
      "outputs": ["{projectRoot}/test-results", "{projectRoot}/playwright-report"],
      "cache": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "playwright test"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["^build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite preview"
      }
    }
  }
}
