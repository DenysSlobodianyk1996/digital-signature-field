{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.js",
      "{workspaceRoot}/pnpm-lock.yaml"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/dev/**/*",
      "!{projectRoot}/index.html",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/src/testing/**/*",
      "!{projectRoot}/test/**/*",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/playwright.config.ts",
      "!{projectRoot}/karma.conf.cjs",
      "!{projectRoot}/vitest-base.config.ts",
      "!{projectRoot}/tsconfig.e2e.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default"],
      "cache": true
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["default", "^production", { "env": "DSF_BROWSERS" }],
      "cache": true
    },
    "e2e": {
      "dependsOn": ["build"],
      "inputs": ["default", "^production"],
      "cache": true
    },
    "pack": {
      "dependsOn": ["build"],
      "inputs": ["production", "^production", "{workspaceRoot}/tools/check-package.mjs"],
      "cache": true
    },
    "nx-release-publish": {
      "dependsOn": ["build", "pack"],
      "options": {
        "access": "public"
      }
    }
  },
  "release": {
    "projects": ["element", "angular"],
    "projectsRelationship": "fixed",
    "releaseTag": {
      "pattern": "v{version}"
    },
    "version": {
      "conventionalCommits": true,
      "fallbackCurrentVersionResolver": "disk",
      "preserveLocalDependencyProtocols": true
    },
    "changelog": {
      "automaticFromRef": true,
      "workspaceChangelog": {
        "file": "{workspaceRoot}/CHANGELOG.md",
        "createRelease": "github"
      },
      "projectChangelogs": false
    },
    "git": {
      "commitMessage": "chore(release): publish {version}"
    }
  }
}
