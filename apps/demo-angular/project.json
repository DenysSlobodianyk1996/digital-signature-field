{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "demo-angular",
  "projectType": "application",
  "sourceRoot": "apps/demo-angular/src",
  "tags": ["scope:demo", "type:angular"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "ng build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "ngc -p tsconfig.app.json --noEmit",
          "ngc -p tsconfig.spec.json --noEmit",
          "tsc -p tsconfig.e2e.json"
        ],
        "parallel": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "eslint ."
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "ng test"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "playwright test"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "{projectRoot}",
        "command": "ng serve"
      }
    }
  }
}
